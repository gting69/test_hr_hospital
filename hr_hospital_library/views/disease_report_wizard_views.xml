<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="disease_report_wizard_view_form" model="ir.ui.view">
        <field name="name">disease.report.wizard.form</field>
        <field name="model">disease.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Disease Report Parameters">
                <group>
                    <group string="Period">
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group string="Filters">
                        <field name="doctor_ids" widget="many2many_tags" placeholder="All Doctors if empty"/>
                        <field name="disease_ids" widget="many2many_tags" placeholder="All Diseases if empty"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_disease_report_wizard_binding" model="ir.actions.act_window">
        <field name="name">Disease Analysis Report</field>
        <field name="res_model">disease.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr_hospital_library.model_hr_hospital_library_doctor"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
