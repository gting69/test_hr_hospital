<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_hospital_library_doctor_view_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.library.doctor.kanban</field>
        <field name="model">hr.hospital.library.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="specialty_id" quick_create="false" sample="1">
                <field name="id"/>
                <field name="display_name"/>
                <field name="specialty_id"/>
                <field name="intern_ids"/>
                <field name="is_intern"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click shadow-sm border-info">
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle btn" data-bs-toggle="dropdown" href="#" role="button">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable"><a type="edit" class="dropdown-item">Edit</a></t>
                                    <t t-if="widget.deletable"><a type="delete" class="dropdown-item">Delete</a></t>
                                </div>
                            </div>

                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="display_name"/>
                                </strong>

                                <div class="text-muted">
                                    <field name="specialty_id"/>
                                </div>

                                <t t-if="!record.is_intern.raw_value &amp;&amp; record.intern_ids.raw_value.length > 0">
                                    <div class="mt-2">
                                        <strong>Interns:</strong>
                                        <field name="intern_ids" widget="many2many_tags"/>
                                    </div>
                                </t>

                                <div class="mt-3">
                                    <button name="%(hr_hospital_library.action_hr_hospital_library_visit_window)d"
                                            type="action" class="btn btn-primary btn-sm"
                                            context="{'default_doctor_id': active_id}">
                                        Schedule Visit
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_hospital_library_doctor_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.library.doctor.search</field>
        <field name="model">hr.hospital.library.doctor</field>
        <field name="arch" type="xml">
            <search>
                <filter name="mentors" string="Mentors" domain="[('is_intern', '=', False)]"/>
                <filter name="interns" string="Interns" domain="[('is_intern', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Specialty" name="specialty" context="{'group_by': 'specialty_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_hospital_library_doctor_tree" model="ir.ui.view">
        <field name="name">hr.hospital.library.doctor.tree</field>
        <field name="model">hr.hospital.library.doctor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="display_name"/>
                <field name="specialty_id"/>
                <field name="phone"/>
                <field name="experience"/>
                <field name="rating"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_library_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.library.doctor.form</field>
        <field name="model" >hr.hospital.library.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="last_name" placeholder="Last Name" style="margin-right: 10px;"/>
                            <field name="first_name" placeholder="First Name" style="margin-right: 10px;"/>
                            <field name="middle_name" placeholder="Middle Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Contacts">
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="lang_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group string="Professional Info">
                        <group>
                            <field name="license_number"/>
                            <field name="license_date"/>
                            <field name="experience"/>
                            <field name="specialty_id"/>
                        </group>
                        <group>
                            <field name="is_intern"/>
                            <field name="mentor_id" invisible="not is_intern" required="is_intern"/>
                            <field name="rating"/>
                            <field name="education_country_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Interns" name="interns" invisible="is_intern">
                            <field name="intern_ids" mode="kanban" readonly="1"/>
                        </page>
                        <page string="Schedule" name="schedule">
                            <field name="schedule_ids">
                                <tree editable="bottom">
                                    <field name="day_of_week"/>
                                    <field name="start_hour" widget="float_time"/>
                                    <field name="end_hour" widget="float_time"/>
                                    <field name="schedule_type"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_library_doctor_window" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hr.hospital.library.doctor</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_specialty': 1}</field>
    </record>
</odoo>
